# Customer Resolution Intelligence — environment template
#
# Copy to .env and fill in your own values. .env is git-ignored.
# NEVER commit real credentials. NEVER place any of these in client-side
# variables or in the Vercel application's public environment.

# --- Snowflake ---
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_ROLE=CRI_TRANSFORMER
SNOWFLAKE_WAREHOUSE=CRI_TRANSFORM_WH
SNOWFLAKE_DATABASE=CUSTOMER_RESOLUTION_INTELLIGENCE
SNOWFLAKE_SCHEMA=ANALYTICS_DEV

# Authenticate with a key pair rather than a password where possible.
# Provide a path, never the key material itself.
SNOWFLAKE_PRIVATE_KEY_PATH=
SNOWFLAKE_PASSWORD=

# --- Source retrieval ---
# The bulk CSV archive is the primary ingestion path.
# Do not switch to the filtered API export: it is capped at ~100,000 rows.
CFPB_BULK_ARCHIVE_URL=https://files.consumerfinance.gov/ccdb/complaints.csv.zip
CFPB_API_BASE_URL=https://www.consumerfinance.gov/data-research/consumer-complaints/search/api/v1/
LOCAL_DATA_DIR=./data

# --- Application (client-safe values only) ---
NEXT_PUBLIC_APP_ENV=development
DEMO_DATA_VERSION=
CONTACT_FORM_ENDPOINT=
